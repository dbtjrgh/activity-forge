{
  "specVersion": 1,
  "module": "M34_1",
  "subject": "MA",
  "title": "시소로 무게 비교",
  "summary": "시소 양쪽에 물건을 끌어다 올려 무게를 견주는 활동. 물건마다 무게가 정해져 있고, 양쪽 무게 합에 따라 시소가 기울어집니다.",
  "reference": {
    "module": "sparkon_common/_common/module/MA/M34_1",
    "activities": [
      "MAL2M05W2S3",
      "MAL2M11W4S2",
      "MAL3M04W3S3"
    ],
    "doc": "README 없음. 근거는 M34_1.ts · SeeSaw.ts · Item.ts · ItemBox.ts 와 표본 3차시입니다."
  },
  "codegen": {
    "hooks": {
      "onLoad": [
        "M34_1.addAsset();"
      ],
      "onInit": [
        "M34_1.handle.init(quizData);",
        "this.addChild(M34_1.handle);"
      ],
      "onStart": [
        "await M34_1.handle.start();",
        "for(const data of quizData.inningData) {",
        "  await M34_1.handle.readyInning(data);",
        "  await M34_1.handle.playInning();",
        "  await M34_1.handle.endInning();",
        "}",
        "await M34_1.handle.finish();",
        "SparkApp.eop.show(1);"
      ],
      "onEnd": [
        "// 이곳에 액티비티 종료시의 코드를 입력하세요"
      ],
      "onUpdate": [
        "// 이곳에 액티비티 Loop Step의 코드를 입력하세요."
      ],
      "onAffordanceOn": [
        "await M34_1.handle.onAffordanceOn();"
      ],
      "onAffordanceCanceled": [
        "await M34_1.handle.onAffordanceCanceled();"
      ]
    },
    "gameDataExport": "quizData",
    "extends": {
      "symbol": "ActivityBase",
      "from": "@_common/sparkLib/ActivityBase"
    },
    "imports": [
      {
        "symbol": "M34_1",
        "from": "@_common/module/MA"
      },
      {
        "symbol": "SparkApp",
        "from": "@_common/sparkLib/Application"
      }
    ]
  },

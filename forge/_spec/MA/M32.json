  "rules": [
    {
      "id": "name-links-three-lists",
      "level": "error",
      "check": "inningbar.item[].name 과 notePanel.item[].name 이 items[].name 중 하나와 정확히 같아야 한다.",
      "why": "**이 모듈은 name 하나로 세 목록을 잇습니다**(M32.ts:143·190 · NotePanel.ts:171 · InningBar.ts:261). 이름이 어긋나면 눌러서 찾아도 띠와 노트가 채워지지 않아 **이닝이 끝나지 않습니다.** 에러는 없습니다."
    },
    {
      "id": "touch-items-have-name",
      "level": "error",
      "check": "type 이 item 인 칸은 name 이 있어야 한다.",
      "why": "장식(deco-*)은 이름이 없어도 되지만, 찾는 대상은 이름으로 연결됩니다. 이름이 없으면 찾아도 아무 일이 없습니다."
    },
    {
      "id": "touch-controls-autoplay",
      "level": "warn",
      "check": "장식 애니를 저절로 돌리려면 touch 를 false 로 둔다.",
      "why": "BG.ts:22 가 `autoplay: !touch` 입니다 — touch: true 로 두면 애니가 멈춰 있습니다. 두 뜻이 한 값에 묶여 있어 헷갈립니다."
    },
    {
      "id": "align-zero-is-value",
      "level": "warn",
      "check": "정렬을 0 으로 두고 싶으면 0 을 적는다 — 키를 지우면 기본 정렬이 된다.",
      "why": "NotePanel.ts:229 가 0 을 값으로 받아들이도록 따로 검사합니다. 키를 지우는 것과 0 은 다릅니다."
    },
    {
      "id": "legacy-lottie-alias",
      "level": "warn",
      "check": "MAL1M02W3S3_ 로 시작하는 로티는 모듈이 물고 있으니 액티비티에서 등록하지 않는다.",
      "why": "활동 이름처럼 보이지만 모듈 공용 이름입니다. 같은 alias 를 다시 등록하면 PixiJS 가 덮어씁니다."
    },
    {
      "id": "start-narration-lowercase",
      "level": "warn",
      "check": "시작 지문 열쇠는 startnarration 이다(소문자 n).",
      "why": "다른 모듈은 startNarration 을 씁니다. 대문자로 적으면 조용히 무음으로 시작합니다."
    },
    {
      "id": "alias-exists-in-assettable",
      "level": "error",
      "check": "bg[] · items[] 의 그림·애니·음원 alias 가 AssetTable 에 있어야 한다.",
      "why": "없는 그림은 console.error 만 찍고 사라지고, 없는 음원은 무음으로 통과합니다."
    }
  ],
  "notes": [
    "eop 는 액티비티 onStart 가 부릅니다. 모듈은 부르지 않습니다.",
    "노트 넘기기 버튼(note_prev_btn · note_next_btn)은 모듈이 물고 있습니다. 노트가 여러 장일 때 자동으로 붙습니다.",
    "8호에는 이 모듈을 쓰는 자리가 없습니다."
  ]
}

{
  "specVersion": 1,
  "module": "M18",
  "subject": "MA",
  "title": "다리 건너기 (수만큼 다리 놓기)",
  "summary": "캐릭터가 다리를 건너가는 활동. 다리 조각을 골라 놓아 길을 이으면 캐릭터가 뛰어 건너고, 이닝마다 다리 구성과 정답이 다릅니다.",
  "reference": {
    "module": "sparkon_common/_common/module/MA/M18",
    "activities": [
      "MAL1M01W4S2"
    ],
    "doc": "README 없음. 근거는 M18.ts 와 M18_Bridge · M18_BridgeManager · M18_Monster · M18_MoveMonster · M18_EffectPlayer · M18_BlockScreen 그리고 표본 MAL1M01W4S2 입니다."
  },
  "codegen": {
    "extends": {
      "symbol": "ActivityBase",
      "from": "@_common/sparkLib/ActivityBase"
    },
    "imports": [
      {
        "symbol": "M18",
        "from": "@_common/module/MA/M18/M18"
      },
      {
        "symbol": "AssetTable",
        "from": "./AssetTable",
        "ns": true
      }
    ],
    "members": [
      "private readonly mM18: M18 = new M18();"
    ],
    "hooks": {
      "onLoad": [
        "await this.mM18.onLoad({",
        "  font: AssetTable.font,",
        "  image: AssetTable.image,",
        "  sound: AssetTable.sound,",
        "  lottie: AssetTable.lottie,",
        "});"
      ],
      "onInit": [
        "this.eventMode = 'static';",
        "this.interactive = true;",
        "await this.mM18.onInit(this, quizData);"
      ],
      "onStart": [
        "await this.mM18.onStart();"
      ],
      "onEnd": [
        "await this.mM18.onEnd();"
      ],
      "onUpdate": [
        "await this.mM18.onUpdate();"
      ],
      "onAffordanceOn": [
        "await this.mM18.onAffordanceOn();"
      ],
      "onAffordanceCanceled": [
        "await this.mM18.onAffordanceCanceled();"
      ]
    },
    "gameDataExport": "quizData"
  },

    "module": "sparkon_common/_common/module/MA/M34_2",
    "activities": [
      "MAL1M05W1S3",
      "MAL1M05W2S3",
      "MAL1M11W4S3",
      "MAL2M05W1S2"
    ],
    "doc": "README 없음. 근거는 M34_2.ts · SeeSaw.ts · Item.ts · ItemBox.ts · SelectInning.ts 와 표본 3차시입니다."
  },
  "codegen": {
    "hooks": {
      "onLoad": [
        "M34_2.addAsset();"
      ],
      "onInit": [
        "M34_2.handle.init(quizData);",
        "this.addChild(M34_2.handle);"
      ],
      "onStart": [
        "await M34_2.handle.start();",
        "await M34_2.handle.play();",
        "await M34_2.handle.finish();",
        "SparkApp.eop.show(1);"
      ],
      "onEnd": [
        "// 이곳에 액티비티 종료시의 코드를 입력하세요"
      ],
      "onUpdate": [
        "// 이곳에 액티비티 Loop Step의 코드를 입력하세요."
      ],
      "onAffordanceOn": [
        "await M34_2.handle.onAffordanceOn();"
      ],
      "onAffordanceCanceled": [
        "await M34_2.handle.onAffordanceCanceled();"
      ]
    },
    "gameDataExport": "quizData",
    "extends": {
      "symbol": "ActivityBase",
      "from": "@_common/sparkLib/ActivityBase"
    },

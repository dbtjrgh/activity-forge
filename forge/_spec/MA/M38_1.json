  "rules": [
    {
      "id": "count-matches-card",
      "level": "error",
      "check": "kinds[k].positions 의 개수 = table.cards 카드에 그려진 숫자 = answer 내레이션이 말하는 수.",
      "why": "모듈은 카드 숫자를 모릅니다. 셋이 어긋나도 에러 없이 진행돼 화면 · 소리만 틀립니다."
    },
    {
      "id": "card0-second-row-empty",
      "level": "error",
      "check": "table.empty 가 없으면 cards[0] 의 2행 수 칸이 비어 있어야 한다.",
      "why": "빈 표를 그 칸 조각으로 덮어 보이므로, 거기 숫자가 있으면 시작부터 숫자가 보입니다."
    },
    {
      "id": "kinds-differ",
      "level": "error",
      "check": "한 이닝 두 종류의 image 가 달라야 한다.",
      "why": "판정을 종류 차례로 하므로 같은 그림이면 아이가 구별할 수 없습니다."
    }
  ],

        "super.onLoad();"
      ],
      "onInit": [
        "await this.M12.init();"
      ],
      "onStart": [
        "const bgm = AudioManager.getSound(\"bgm\");",
        "bgm.loop(true);",
        "bgm.volume(0.1);",
        "bgm.play();",
        "await this.M12.Start();"
      ],
      "onAffordanceOn": [
        "await this.M12.onAffordanceOn();"
      ],
      "onAffordanceCanceled": [
        "await this.M12.onAffordanceCanceled();"
      ]
    },

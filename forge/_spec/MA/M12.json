    "module": "sparkon_common/_common/module/MA/M12",
    "activities": [
      "MAL1M04W2S2",
      "MAL1M05W4S2",
      "MAL1M06W2S2",
      "MAL1M11W4S2",
      "MAL2M01W4S2"
    ],
    "doc": "README 없음. 근거는 M12.ts · InningManager.ts · Road.ts · Target.ts · Animation.ts 와 표본 5차시입니다."
  },

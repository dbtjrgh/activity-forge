{
  "specVersion": 1,
  "module": "M33",
  "subject": "MA",
  "title": "지오보드 (핀 이어 도형 만들기)",
  "summary": "핀이 격자로 박힌 판에서 핀과 핀을 이어 선을 만들고, 정답 도형을 완성하는 활동. 붓(색)을 골라 그을 수 있고 이닝마다 만들 도형이 다릅니다.",
  "reference": {
    "module": "sparkon_common/_common/module/MA/M33",
    "activities": [
      "MAL1M03W2S3",
      "MAL1M11W3S3",
      "MAL2M03W2S3",
      "MAL2M11W3S2",
      "MAL3M03W2S3"
    ],
    "doc": "README 없음. 근거는 M33.ts · GeoBoard.ts · GeoLine.ts · InningBar.ts · SelectPanel.ts · EndingPage.ts 와 표본 3차시입니다."
  },
  "codegen": {
    "hooks": {
      "onInit": [
        "// 이곳에 플레이 버튼을 입력하기 전에 생성할 코드를 입력하세요",
        "M33.handle.init(quizData);",
        "this.addChild(M33.handle);"
      ],
      "onStart": [
        "// 이곳에 플레이 버튼을 입력하고 난 이후의 코드를 입력하세요.",
        "await M33.handle.start();",
        "await SparkApp.mainMenu.mainCharacter.guide(\"guide_nar01\");",
        "await M33.handle.play();",
        "await M33.handle.finish();"
      ],
      "onEnd": [
        "// 이곳에 액티비티 종료시의 코드를 입력하세요"
      ],
      "onUpdate": [
        "// 이곳에 액티비티 Loop Step의 코드를 입력하세요."
      ]
    },
    "gameDataExport": "quizData",

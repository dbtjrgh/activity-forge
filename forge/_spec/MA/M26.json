      "onLoad": [
        "  M26.addAsset();"
      ],
      "onInit": [
        "  this.addChild( M26.handle );",
        "  await M26.handle.init( quizData );"
      ],
      "onStart": [
        "  await M26.handle.start();",
        "  await M26.handle.play();",
        "  await M26.handle.finish();",
        "  // await SparkApp.eop.show();"
      ],
      "onEnd": [
        "  // 이곳에 액티비티 종료시의 코드를 입력하세요"
      ],
      "onUpdate": [
        "  // 이곳에 액티비티 Loop Step의 코드를 입력하세요."
      ],
      "onResize": [
        "  M26.handle.onResize();"
      ]
    },
    "gameDataExport": "quizData",

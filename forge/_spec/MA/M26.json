  "reference": {
    "module": "sparkon_common/_common/module/MA/M26",
    "activities": [
      "MAL1M02W2S2",
      "MAL1M03W3S2",
      "MAL1M11W2S2",
      "MAL2M02W2S2",
      "MAL2M03W3S2"
    ],
    "doc": "README 없음. 근거는 M26.ts · DrawPanel.ts · ObjectQuiz.ts · ObjectAnswer.ts · ObjectResult.ts · BG.ts 와 표본 5차시입니다."
  },
  "codegen": {

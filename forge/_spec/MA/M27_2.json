  "rules": [
    {
      "id": "fixed-alias-registered",
      "level": "error",
      "check": "AssetTable.lottie 에 alias 'correct_ef' 가 있어야 한다.",
      "why": "AnswerPanel.ts:53 이 이 이름으로 직접 찾습니다. 없으면 빌드는 통과하고 정답 파티클만 안 나옵니다."
    },
    {
      "id": "exactly-one-correct",
      "level": "error",
      "check": "모든 inningData[].answer.items 에서 correct: true 가 정확히 1개.",
      "why": "모듈이 검사하지 않습니다. 0개면 이닝이 끝나지 않고, 2개 이상이면 앞의 것만 정답으로 칩니다."
    },
    {
      "id": "random-needs-pos-table",
      "level": "error",
      "check": "answerData.isRandom 이 true 면, 나오는 모든 선지 개수에 대해 answerData.pos[개수] 가 있어야 한다.",
      "why": "AnswerPanel 이 answerData.pos[선지수][i] 를 그대로 참조합니다. 없으면 선지가 겹쳐 쌓입니다."
    },
    {
      "id": "alias-on-for-every-item",
      "level": "error",
      "check": "inningData[].answer.items[].alias_on 이 선지마다 비어 있지 않아야 한다.",
      "why": "정답을 맞히면 선지 **전부**가 _on 으로 바뀝니다(coverOn). 오답 선지의 _on 이 없으면 그 자리만 안 바뀝니다."
    },
    {
      "id": "no-empty-ani-placeholder",
      "level": "error",
      "check": "quiz.bg.ani 가 있으면 idle·talk·correct 셋 다 비어 있지 않아야 한다. 이미지 방식이면 ani 키를 아예 두지 말 것.",
      "why": "QuizPanel 이 hasOwnProperty 로 가르므로 빈 플레이스홀더가 애니 방식을 강제합니다."
    },
    {
      "id": "answer-pos-offset",
      "level": "warn",
      "check": "inningData[].answer.slide 가 빈 문자열이면 answer.pos.y 가 -250 이어야 한다.",
      "why": "mItemRoot.y 가 250 에서 시작하는데 slide 가 없으면 다시 안 잡아 줍니다. 상쇄를 안 하면 선지가 250 아래로 내려갑니다."
    },
    {
      "id": "alias-exists-in-assettable",
      "level": "error",
      "check": "GameData 가 가리키는 모든 alias 가 AssetTable 이나 providedByModule 에 있어야 한다."
    },
    {
      "id": "unknown-field",
      "level": "warn",
      "check": "이 스펙에 없는 키가 GameData 에 있으면 알린다.",
      "why": "모듈은 모르는 키를 조용히 무시합니다. M27 에서 correctEffPos 오타가 그렇게 아무 일도 안 했습니다."
    }
  ]

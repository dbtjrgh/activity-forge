  "title": "폴라로이드 짝 고르기 (M03 변형)",
  "summary": "폴라로이드 사진이 나오고, 아래 패드를 눌러 그림을 바꿔 가며 사진에 맞는 것을 맞추는 활동. 이닝을 다 풀면 마무리 패널에서 그림을 눌러 소리를 들어 봅니다.",
  "reference": {
    "module": "sparkon_common/_common/module/MA/M03_1",
    "activities": [
      "MAL1M03W1S3",
      "MAL1M11W3S1",
      "MAL2M03W1S3"
    ],
    "doc": "README 없음. 근거는 M03_1.ts · PlayStage.ts · Pad.ts · EndPanel.ts 와 표본 3차시입니다."
  },
  "codegen": {
    "hooks": {
      "onLoad": [
        "M03_1.addAsset();"
      ],
      "onInit": [
        "   M03_1.handle.onInit(quizData.endPanel);",
        "   this.addChild(M03_1.handle);"
      ],
      "onStart": [
        "// 이곳에 플레이 버튼을 입력하고 난 이후의 코드를 입력하세요.",
        "await M03_1.handle.start();",
        "await M03_1.handle.play(quizData);",
        "await M03_1.handle.finish();"
      ],
      "onEnd": [
        "// 이곳에 액티비티 종료시의 코드를 입력하세요"
      ],
      "onUpdate": [
        "// 이곳에 액티비티 Loop Step의 코드를 입력하세요."
      ]
    },
    "gameDataExport": "quizData",
    "extends": {
      "symbol": "ActivityBase",
      "from": "@_common/sparkLib/ActivityBase"
    },
    "import": {
      "symbol": "M03_1",
      "from": "@_common/module/MA"
    }
  },

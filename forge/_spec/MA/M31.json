{
  "specVersion": 1,
  "module": "M31",
  "subject": "MA",
  "title": "끌어다 나눠 담기 (캐릭터별 분류)",
  "summary": "캐릭터 여럿이 말풍선으로 무엇을 달라고 말하고, 학생이 아이템을 끌어다 맞는 캐릭터 자리(dragzone)에 놓는 활동. 정답이 필요한 아이템이 모두 안착하면 이닝이 끝납니다.",
  "reference": {
    "module": "sparkon_common/_common/module/MA/M31",
    "activities": [
      "MAL1M06W3S2",
      "MAL2M06W3S2",
      "MAL3M06W3S2"
    ],
    "doc": "README 없음. 근거는 M31.ts · CharacterPanel.ts · QuizPanel.ts · TablePanel.ts · Dragzone.ts 와 6호 세 차시입니다."
  },
  "codegen": {
    "hooks": {
      "onLoad": [
        "M31.addAsset();"
      ],
      "onInit": [
        "M31.handle.init(quizData);",
        "this.addChild(M31.handle);"
      ],
      "onStart": [
        "await M31.handle.start();",
        "await M31.handle.play();",
        "await M31.handle.finish();",
        "SparkApp.eop.show(1);"
      ],
      "onAffordanceOn": [
        "await M31.handle.onAffordanceOn();"
      ],
      "onAffordanceCanceled": [
        "await M31.handle.onAffordanceCanceled();"
      ],
      "onResize": [
        "M31.handle.onResize();"
      ]
    },
    "gameDataExport": "quizData",
    "extends": {
      "symbol": "ActivityBase",
      "from": "@_common/sparkLib/ActivityBase"
    },
    "imports": [
      {
        "symbol": "SparkApp",
        "from": "@_common/sparkLib/Application"
      },
      {
        "symbol": "M31",
        "from": "@_common/module/MA/M31/M31"
      }
    ]
  },
  "assets": {

      "onInit": [
        "SparkApp.cms.updateCompleteProgress(0.3);",
        "const bgSpr = new Sprite(AssetManager.get(\"bg\"));",
        "bgSpr.anchor.set(0.5);",
        "this.addChild(bgSpr);",
        "K31.handle.onInit(quizData.positionData);",
        "this.addChild(K31.handle);"
      ],
      "onStart": [
        "//if(import.meta.env.PROD){",
        "const bgm = AudioManager.getSound(\"bgm\");",
        "bgm.loop(true);",
        "bgm.volume(0.1);",
        "bgm.play();",
        "//}",
        "await K31.handle.onStart(quizData.inningData);",
        "await SparkApp.eop.show(K31.handle.totalPercent / quizData.inningData.length * 0.01);"
      ],
      "onAffordanceOn": [
        "K31.handle.onAffordanceOn();"
      ],
      "onAffordanceCanceled": [
        "K31.handle.onAffordanceCanceled();"
      ]
    },

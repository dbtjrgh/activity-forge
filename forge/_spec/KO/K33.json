    "hooks": {
      "onLoad": [
        "K33.addAsset();"
      ],
      "onInit": [
        "SparkApp.cms.updateCompleteProgress(0.3);",
        "K33.handle.onInit(quizData.setPosition);",
        "this.addChild(K33.handle);"
      ],
      "onStart": [
        "// if(import.meta.env.PROD){",
        "const bgm = AudioManager.getSound(\"bgm\");",
        "bgm.loop(true);",
        "bgm.volume(0.1);",
        "bgm.play();",
        "// }",
        "await K33.handle.onStart(quizData.inningData);",
        "await SparkApp.eop.show(K33.handle.totalPercent / quizData.inningData.length * 0.01);"
      ],
      "onAffordanceOn": [
        "K33.handle.onAffordanceOn();"
      ],
      "onAffordanceCanceled": [
        "K33.handle.onAffordanceCanceled();"
      ]
    },

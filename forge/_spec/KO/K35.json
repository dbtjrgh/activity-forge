        "K35.addAsset();"
      ],
      "onInit": [
        "SparkApp.cms.updateCompleteProgress(0.3);",
        "await K35.handle.onInit(quizData.layerData);",
        "this.addChild(K35.handle);"
      ],
      "onStart": [
        "await K35.handle.onStart(quizData);",
        "await SparkApp.eop.show(K35.handle.totalPercent / quizData.inningData.length * 0.01);"
      ],
      "onAffordanceOn": [
        "K35.handle.onAffordanceOn();"
      ],
      "onAffordanceCanceled": [
        "K35.handle.onAffordanceCanceled();"
      ]
    },

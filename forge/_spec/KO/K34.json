        "const bgSpr = new Sprite(AssetManager.get(\"bg\"));",
        "bgSpr.anchor.set(0.5);",
        "this.addChild(bgSpr);",
        "K34.handle.onInit(quizData);",
        "this.addChild(K34.handle);"
      ],
      "onStart": [
        "//if(import.meta.env.PROD){",
        "const bgm = AudioManager.getSound(\"bgm\");",
        "bgm.loop(true);",
        "bgm.volume(0.1);",
        "bgm.play();",
        "//}",
        "await K34.handle.onStart(quizData);",
        "await SparkApp.eop.show(K34.handle.totalPercent / quizData.inningData.length * 0.01);"
      ],
      "onAffordanceOn": [
        "K34.handle.onAffordanceOn();"
      ],
      "onAffordanceCanceled": [
        "K34.handle.onAffordanceCanceled();"
      ]
    },

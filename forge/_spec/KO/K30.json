  "codegen": {
    "hooks": {
      "onLoad": [
        "K30.addAsset();"
      ],
      "onInit": [
        "SparkApp.cms.updateCompleteProgress(0.3);",
        "const bgSpr = new Sprite(AssetManager.get(\"bg\"));",
        "bgSpr.anchor.set(0.5);",
        "this.addChild(bgSpr);",
        "K30.handle.onInit(quizData);",
        "this.addChild(K30.handle);"
      ],
      "onStart": [
        "// if(import.meta.env.PROD){",
        "const bgm = AudioManager.getSound(\"bgm\");",
        "bgm.loop(true);",
        "bgm.volume(0.1);",
        "bgm.play();",
        "// }",
        "await K30.handle.onStart(quizData);",
        "await SparkApp.eop.show(K30.handle.mQuizPanel.totalPercent / quizData.inning.length * 0.01);"
      ],
      "onUpdate": [
        "K30.handle.onUpdate(_ticker);"
      ],
      "onAffordanceOn": [
        "K30.handle.onAffordanceOn();"
      ],
      "onAffordanceCanceled": [
        "K30.handle.onAffordanceCanceled();"
      ]
    },
    "gameDataExport": "quizData",
    "extends": {
      "symbol": "ActivityBase",
      "from": "@_common/sparkLib/ActivityBase"
    },
    "imports": [
      {
        "symbol": "Sprite",

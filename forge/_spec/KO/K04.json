  "codegen": {
    "hooks": {
      "onLoad": [
        "super.onLoad();"
      ],
      "onInit": [
        "const inning = quizData.settings.lastInning;",
        "await this.mCom_Content.ProgressRateInitialize(0, inning);",
        "//SparkApp.mainMenu.inningDisplay.setInningCount(inning);",
        "await this.K04.init();"
      ],
      "onStart": [
        "   // SparkApp.mainMenu.inningDisplay.show();",
        "const bgm = AudioManager.getSound('bgm');",
        "bgm.loop(true);",
        "bgm.volume(0.1);",
        "bgm.play();",
        "await SparkApp.mainMenu.mainCharacter.show();",
        "console.log('lastInning : ', quizData.settings.lastInning);",
        "for (const _ of quizData.settings.inningCount) {",
        "  if (this.inningCount > 0) {",
        "    await this.mCom_Content.AchievementUpdate(",
        "      this.K04.getAccumulateCount,",
        "      false,",
        "      true,",
        "    );",
        "    this.K04.getQuiz.accumulateCount = 0;",
        "  }",
        "  await this.mCom_Content.ProgressRateUpdate(this.inningCount);",
        "  this.inningCount++;",
        "  //await SparkApp.mainMenu.inningDisplay.setInningComplete(this.inningCount);",
        "  await this.K04.change_inning();",
        "}",
        "await this.mCom_Content.AchievementUpdate(",
        "  this.K04.getAccumulateCount,",
        "  true,",
        "  true,",
        ");",
        "await SparkApp.eop.show();"
      ],
      "onAffordanceOn": [
        "await this.K04.affordanceNarration();"
      ],
      "onAffordanceCanceled": [
        "await this.K04.killAffordandeAni();"
      ]
    },
    "gameDataExport": "quizData",

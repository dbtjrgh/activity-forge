            },
            {
              "key": "sticker",
              "type": "array",
              "required": true,
              "minLength": 2,
              "of": {
                "key": "",
                "type": "object",
                "fields": [
                  {
                    "key": "icon",
                    "type": "asset:image",
                    "required": true,
                    "desc": "스티커 판에 뜨는 작은 그림."
                  },
                  {
                    "key": "image",
                    "type": "asset:image",
                    "required": true,
                    "desc": "골라서 붙였을 때 실제로 붙는 큰 그림. icon 과 **다른 그림**입니다 — 기존 5개가 sticker0101 / st0101 처럼 짝을 두고 있습니다."
                  }
                ],
                "desc": "칸 하나."
              },
              "desc": "그 낱말에서 고를 수 있는 스티커. 기존 5개가 다 **넷**입니다.",
              "minLengthWhy": "고를 것이 하나뿐이면 고르는 뜻이 없습니다. 기존 5개는 넷씩입니다."

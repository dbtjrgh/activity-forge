        "of": {
          "key": "",
          "type": "object",
          "fields": [
            {
              "key": "words",
              "type": "string",
              "required": true,
              "desc": "따라 쓸 낱말. **그림이 아니라 글자 그대로**입니다 — 모듈이 폰트로 획을 그려 냅니다. 그래서 글자만 바꾸면 되고 그림을 따로 안 만듭니다."
            },
            {
              "key": "sounds",
              "type": "asset:sound",

{
  "specVersion": 1,
  "module": "ShowcaseWriteLv1",
  "subject": "EN",
  "title": "낱말 따라 쓰고 꾸미기 — 글씨를 덧쓰고 스티커를 붙입니다",
  "summary": "판 위에 낱말이 흐리게 적혀 있고 마커로 획을 따라 덧씁니다. 다 쓰면 스티커 판이 열려 그 낱말에 어울리는 스티커를 골라 붙입니다. 꾸민 그림은 사진으로 찍혀 앨범에 쌓이고, 끝나면 앨범을 넘겨 보며 낱말 소리를 다시 들을 수 있습니다. 이닝 차례는 열 때마다 섞입니다.",
  "reference": {
    "module": "sparkon_common/_common/module/EN/ShowcaseWriteLv1",
    "activities": [
      "ENL1M01W4S2",
      "ENL1M02W4S2",
      "ENL1M03W4S2",
      "ENL1M04W4S2",
      "ENL1M05W4S2"
    ]
  },
  "codegen": {
    "hooks": {
      "onLoad": [
        "ShowcaseWriteLv1.addAsset();",
        "// DrawWord.addAsset();"
      ],
      "onInit": [
        "SparkApp.cms.updateCompleteProgress(0.5);",
        "this.addChild( ShowcaseWriteLv1.handle );",
        "ShowcaseWriteLv1.handle.init(quizData);"
      ],
      "onStart": [
        "await ShowcaseWriteLv1.handle.start();",
        "await ShowcaseWriteLv1.handle.play();",
        "await ShowcaseWriteLv1.handle.finish();",
        "await SparkApp.eop.show(1);"
      ],
      "onEnd": [
        "// 이곳에 액티비티 종료시의 코드를 입력하세요"
      ],
      "onUpdate": [
        "// 이곳에 액티비티 Loop Step의 코드를 입력하세요."
      ],
      "onResize": [
        "ShowcaseWriteLv1.handle.onResize();"
      ]
    },
    "gameDataExport": "quizData",
    "extends": {
      "symbol": "ActivityBase",
      "from": "@_common/sparkLib/ActivityBase"
    },
    "imports": [
      {
        "symbol": "ShowcaseWriteLv1",
        "from": "@_common/module/EN/ShowcaseWriteLv1/ShowcaseWriteLv1"
      },
      {
        "symbol": "SparkApp",
        "from": "@_common/sparkLib/Application"
      }
    ]
  },
  "assets": {

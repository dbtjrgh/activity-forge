      "onStart": [
        "await E07.handle.start();",
        "await E07.handle.play();",
        "await E07.handle.finish();",
        "await SparkApp.eop.show(E07.handle.completePercent);"
      ],
      "onResize": [
        "E07.handle.resize();"
      ]
    },

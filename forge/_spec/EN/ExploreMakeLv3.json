{
  "specVersion": 1,
  "module": "ExploreMakeLv3",
  "subject": "EN",
  "title": "나만의 이야기책 짓기 — 표지를 고르고 칸마다 골라 채워 책을 냅니다",
  "summary": "먼저 책 표지를 고릅니다. 책이 펼쳐지면 인물·배경 같은 칸이 차례로 나오고, 칸마다 고를 것 셋이 놓입니다. 문제 칸(quiz)은 맞는 것을 골라야 넘어가고, 고르기 칸(choice)은 마음에 드는 것을 고릅니다. 고른 것이 그 칸의 빈자리에 붙습니다. 다 채우면 이름을 적고 책이 완성되어 불꽃이 터집니다.",
  "reference": {
    "module": "sparkon_common/_common/module/EN/ExploreMakeLv3",
    "activities": [
      "ENL3M01W2S3",
      "ENL3M02W2S3",
      "ENL3M03W2S3",
      "ENL3M04W2S3",
      "ENL3M05W2S3"
    ]
  },
  "codegen": {
    "hooks": {
      "onLoad": [
        "ExploreMakeLv3.addAsset();"
      ],
      "onInit": [
        "// 화면 진입시 성취율 업로드",
        "SparkApp.cms.updateCompleteProgress(0.3);",
        "await ExploreMakeLv3.handle.init( quizData )",
        "this.addChild( ExploreMakeLv3.handle )"
      ],
      "onStart": [
        "await ExploreMakeLv3.handle.start();",
        "await ExploreMakeLv3.handle.play();",
        "await ExploreMakeLv3.handle.finish();",
        "console.log(\">>>acticity\",ExploreMakeLv3.handle.totalPercent)",
        "await SparkApp.eop.show((ExploreMakeLv3.handle.totalPercent / ExploreMakeLv3.handle.mQuizCount) * 0.01);"
      ],
      "onResize": [
        "ExploreMakeLv3.handle.onResize();"
      ]
    },
    "gameDataExport": "quizData",
    "extends": {
      "symbol": "ActivityBase",
      "from": "@_common/sparkLib/ActivityBase"
    },
    "imports": [
      {
        "symbol": "SparkApp",
        "from": "@_common/sparkLib/Application"
      },
      {
        "symbol": "ExploreMakeLv3",
        "from": "@_common/module/EN"
      }
    ]
  },
  "assets": {
    "required": [],
    "providedByModule": {
      "note": "**책과 칸, 안내까지 모듈 것입니다.** Assets.ts 가 배경·책 표지 여러 벌·펼친 책·칸 판·이름표·단추·불꽃·효과음·시작 안내를 등록합니다(90개). **액티비티는 그 이야기의 낱말 그림과 고를 것들의 그림만 넣습니다** — 회차가 넣어야 할 이름이 GameData 에만 있고 고정 자원은 없습니다.",
      "image": [
        "bg",
        "book01~book06",
        "book_open02~06",
        "bookTitle",
        "title",
        "by",
        "by_line",
        "name",
        "nametag",
        "answerPanel",
        "contentsPanel01~04",
        "quiz01~04_blank",
        "write02~write06",
        "section01~04"
      ],
      "lottie": [
        "firework",
        "fireworks"
      ],
      "sound": [
        "bgm",
        "nar03-1 · nar03-2 (시작 안내)",
        "sfx02·03·04·11·14·15"
      ]
    }
  },

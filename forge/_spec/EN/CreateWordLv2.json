  "rules": [
    {
      "id": "fixed-alias-registered",
      "level": "error",
      "check": "bg · board · board_answer · bgm · nar02 · sound* 여섯 · ani_* 다섯 · comNar01~03 · comNar07~09 · comNar10~12 가 AssetTable 에 있어야 한다.",
      "why": "모듈 Asset.ts 가 모두 주석이라 이 이름들을 아무도 등록해 주지 않습니다. 없는 그림은 비고, 없는 소리는 무음으로 지나갑니다."
    },
    {
      "id": "answerplanet-in-baseplanet",
      "level": "error",
      "check": "infoList 의 answerPlanet 이 basePlanet 에 있는 이름이어야 한다.",
      "why": "오답 행성을 basePlanet 에서 뽑는데, 정답이 그 목록에 없으면 정답과 오답이 같은 그림이 될 수 있습니다."
    },
    {
      "id": "map-matches-planetpos",
      "level": "error",
      "check": "infoList 의 map 칸 수가 planetPos 칸 수와 같아야 한다.",
      "why": "map 은 자리마다 정답인지를 적은 것입니다. 칸 수가 다르면 마지막 자리가 undefined 라 눌러도 판정이 안 됩니다."
    },
    {
      "id": "add-ani-one-fewer",
      "level": "warn",
      "check": "rocketAddAni 는 rocketIdleAni 보다 하나 적어야 한다(ufo 도 같음).",
      "why": "처음 모습에는 자라는 장면이 없습니다. 수가 맞지 않으면 마지막 단계에서 자라는 장면이 undefined 가 되어 그냥 툭 바뀝니다."
    },
    {
      "id": "alias-exists-in-assettable",
      "level": "error",
      "check": "GameData 가 가리키는 모든 asset alias 가 AssetTable 에 있어야 한다."
    },
    {
      "id": "unknown-field",
      "level": "warn",
      "check": "이 스펙에 없는 키가 GameData 에 있으면 경고."
    }
  ]
}

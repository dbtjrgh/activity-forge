{
  "specVersion": 1,
  "module": "CreateWordLv2",
  "subject": "EN",
  "title": "우주선 낱말 여행 — 맞는 행성을 골라 우주선을 키웁니다",
  "summary": "우주선이 왼쪽에서 출발하고 오른쪽에 행성 둘이 떠 있습니다. 낱말 소리가 나면 그 낱말이 적힌 행성으로 우주선을 보냅니다. 맞으면 행성이 붙으면서 우주선이 한 단계 자라고, 틀리면 부딪혀 터집니다. 이닝 묶음을 다 지나면 다음 묶음으로 넘어갑니다.",
  "reference": {
    "module": "sparkon_common/_common/module/EN/CreateWordLv2",
    "activities": [
      "ENL2M01W3S2",
      "ENL2M03W3S2",
      "ENL2M05W3S2",
      "ENL2M11W1S2"
    ]
  },
  "codegen": {
    "hooks": {
      "onLoad": [
        "CreateWordLv2.addAsset();"
      ],
      "onInit": [
        "await CreateWordLv2.handle.init(quizData);",
        "this.addChild( CreateWordLv2.handle );"
      ],
      "onStart": [
        "await CreateWordLv2.handle.start();",
        "await CreateWordLv2.handle.play();",
        "await CreateWordLv2.handle.finish();",
        "// await SparkApp.eop.show(GameMap.handle.totalPercent / quizData.infoList.length * 0.01);",
        "await SparkApp.eop.show( CreateWordLv2.handle.completePercent );"
      ],
      "onUpdate": [
        "// 이곳에 액티비티 Loop Step의 코드를 입력하세요.",
        "CreateWordLv2.handle.update(_ticker);"
      ]
    },
    "gameDataExport": "quizData",
    "extends": {
      "symbol": "ActivityBase",
      "from": "@_common/sparkLib/ActivityBase"
    },
    "imports": [
      {
        "symbol": "SparkApp",
        "from": "@_common/sparkLib/Application"
      },
      {
        "symbol": "CreateWordLv2",
        "from": "@_common/module/EN"
      }
    ]
  },

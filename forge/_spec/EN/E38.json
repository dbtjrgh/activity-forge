    "hooks": {
      "onInit": [
        "SparkApp.cms.updateCompleteProgress(0.3);",
        "this.mGame.init( quizData );",
        "this.addChild(this.mGame);"
      ],
      "onStart": [
        "const bgm = AudioManager.getSound(\"SL_en_com_bgm_02\");",
        "bgm.loop(true);",
        "bgm.volume(1);",
        "bgm.play();",
        "await this.mGame.play();",
        "await SparkApp.eop.show(this.mGame.totalCount /  quizData.inningData.length);"
      ],
      "onAffordanceOn": [
        "await this.mGame.onAffodance();"
      ]
    },
    "gameDataExport": "quizData"
  },

                "default": "#808080",
                "desc": "판 바탕색. 기존 5개가 다 #808080 입니다."
              },
              {
                "key": "wordPanel",
                "type": "enum",
                "required": true,
                "values": [
                  "#E8ECFF",
                  "#FFF9D8"
                ],
                "desc": "낱말 칸 색. 회차마다 #E8ECFF 나 #FFF9D8 을 씁니다."
              }

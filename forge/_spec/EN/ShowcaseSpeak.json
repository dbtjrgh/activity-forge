{
  "specVersion": 1,
  "module": "ShowcaseSpeak",
  "subject": "EN",
  "title": "낱말 따라 말하기 — 화면 속 아이를 보고 소리 내어 말합니다",
  "summary": "커다란 모니터 안에 아이가 서 있습니다. 낱말 그림이 뜨고 아이가 그 낱말을 말해 줍니다. 스피커를 누르면 다시 들을 수 있고 느리게도 들을 수 있습니다. 아이가 듣는 몸짓으로 바뀌면 따라 말합니다. 낱말 수만큼 되풀이하고, 끝나면 배운 낱말이 한 판에 모여 나옵니다.",
  "reference": {
    "module": "sparkon_common/_common/module/EN/ShowcaseSpeak",
    "activities": [
      "ENL1M01W4S1",
      "ENL1M02W4S1",
      "ENL1M03W4S1",
      "ENL1M04W4S1",
      "ENL1M05W4S1"
    ]
  },
  "codegen": {
    "hooks": {
      "onLoad": [
        "ShowcaseSpeak.addAsset();"
      ],
      "onInit": [
        "SparkApp.cms.updateCompleteProgress(0.5);",
        "ShowcaseSpeak.handle.init(quizData);",
        "this.addChild( ShowcaseSpeak.handle );"
      ],
      "onStart": [
        "await ShowcaseSpeak.handle.start();",
        "SparkApp.mainMenu.inningDisplay.setInningCount(quizData.inning.length);",
        "SparkApp.mainMenu.inningDisplay.show();",
        "for( let inningIDX=0; inningIDX<quizData.inning.length; inningIDX++){",
        "  SparkApp.mainMenu.inningDisplay.setInningComplete(inningIDX+1);",
        "  console.log(\"이닝시작\",inningIDX)",
        "  await ShowcaseSpeak.handle.playInning(inningIDX);",
        "  while( !ShowcaseSpeak.handle.isEndInning() ){",
        "   await delay(1);",
        "  }",
        "  console.log(\"이닝 끝\",inningIDX)",
        "}",
        "await ShowcaseSpeak.handle.showResultAlbum();",
        "//await ShowcaseSpeak.handle.showResult();",
        "await ShowcaseSpeak.handle.finish();",
        "SparkApp.eop.show(1);"
      ],
      "onEnd": [
        "// 이곳에 액티비티 종료시의 코드를 입력하세요"
      ],
      "onUpdate": [
        "// 이곳에 액티비티 Loop Step의 코드를 입력하세요."
      ]
    },
    "gameDataExport": "quizData",
    "extends": {
      "symbol": "ActivityBase",
      "from": "@_common/sparkLib/ActivityBase"
    },
    "imports": [
      {
        "symbol": "ShowcaseSpeak",
        "from": "@_common/module/EN"
      },
      {
        "symbol": "SparkApp",
        "from": "@_common/sparkLib/Application"
      },
      {
        "symbol": "delay",
        "from": "@_common/util"
      }
    ]
  },
  "assets": {
    "required": [],
    "providedByModule": {
      "note": "**ShowcaseSpeak 은 무대를 통째로 들고 있습니다.** Assets.ts 가 모니터 틀·단추·이닝 표시·정답 표시·끝맺음 말·배경음·안내 나레이션, 그리고 **화면 속 아이 로티까지** 등록합니다. **액티비티는 낱말 그림과 낱말 소리만 넣습니다.** 회차 AssetTable 에 남아 있는 //{alias:'correct'…} 주석은 **틀에서 딸려 온 것**입니다 — 기존 회차가 모두 주석인 채로 두었고 모듈이 안 찾습니다.",
      "image": [
        "bg",
        "monitor",
        "monitor_frame·_top·_left·_right",
        "button_bar",
        "check_on·check_off",
        "inning_bg·_cursor·_border·_divide·_gauge",
        "sndBtn_* (스피커 단추 색깔별)",
        "correct",
        "incorrect",
        "end_awesome 등 끝맺음 말 여섯"
      ],
      "lottie": [
        "L1_M01_W4_S1_cha_idle·_talk·_listen (여자아이)",
        "EN_L1_M03_W4_S1_cha_idle·_talk·_listen (남자아이)",
        "L1_M01_W4_S1_L_ef_correct·R_ef_correct",
        "L1_M01_W4_S1_screen"
      ],
      "sound": [
        "bgm",
        "SL_en_com_nar93 (시작 안내)",
        "SL_en_com_nar94",
        "SL_en_com_sfx01·sfx02",
        "SL_en_quiz_nar01~24"
      ]
    }
  },

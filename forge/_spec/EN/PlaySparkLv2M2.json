  "rules": [
    {
      "id": "fixed-alias-registered",
      "level": "error",
      "check": "bg · box · sparkling · bgm · SL_en_com_sfx01 · SL_en_com_sfx04 · SL_en_com_nar01 · SL_en_com_nar02 · SL_en_com_nar03 이 AssetTable 에 있어야 한다.",
      "why": "addAsset() 이 아무것도 등록하지 않으므로 액티비티가 전부 넣어야 합니다."
    },
    {
      "id": "guide-narration-alias",
      "level": "warn",
      "check": "시작 안내 나레이션 alias 가 AssetTable 에 있어야 한다.",
      "why": "**모듈에 회차 이름이 박혀 있습니다** — PlaySparkLv2M2.ts:126 이 guide(\"SL_en_105_s1_nar02\") 를 그대로 부릅니다. 5호 것입니다. 8호를 만들 때도 **그 alias 로 이번 회차 파일을 가리켜야** 소리가 납니다. 모듈을 고치지 않는 한 이름은 바꿀 수 없습니다."
    },
    {
      "id": "character-state-four",
      "level": "error",
      "check": "things[].character.state 에 idle1 · out · idle4 · in 네 열쇠가 다 있어야 한다.",
      "why": "Thing.ts:40 이 idle1 로 첫 모습을 잡고, :162 가 out·idle4 를 다시 만들어 재생합니다. 하나라도 없으면 AssetManager.get(undefined) 가 되어 그 사물에서 터지거나 아무것도 안 보입니다. in 은 지금 만들어 두기만 하고 쓰지 않지만, 기존 3개가 다 넣고 있어 빠뜨린 것으로 봅니다."
    },
    {
      "id": "alias-exists-in-assettable",
      "level": "error",
      "check": "GameData 가 가리키는 모든 asset alias 가 AssetTable 에 있어야 한다."
    },
    {
      "id": "unknown-field",
      "level": "warn",
      "check": "이 스펙에 없는 키가 GameData 에 있으면 경고."
    }
  ],
  "relations": [
    {

{
  "specVersion": 1,
  "module": "WordSparkLv3M2",
  "subject": "EN",
  "title": "파이프 조립해 물탱크 채우기 (낱말 철자)",
  "summary": "물탱크로 이어지는 파이프에 빠진 부품(동그라미·손잡이·작은관)을 색칠된 것 중에서 골라 끼우는 활동. 파이프를 다 채우면 물이 흐릅니다.",
  "reference": {
    "module": "sparkon_common/_common/module/EN/WordSparkLv3M2",
    "activities": [
      "ENL3M02W1S3",
      "ENL3M04W1S3",
      "ENL3M06W1S3"
    ],
    "doc": "README 없음. 근거는 WordSparkLv3M2.ts · MainScene.ts · Scene.ts · Pipe.ts · OptionManager.ts · AnswerCard.ts · Bg.ts 와 표본 3차시(2·4·6호)입니다. 자리는 세 호 모두 ENL3M__W1S3 입니다."
  },
  "codegen": {
    "hooks": {
      "onInit": [
        "// 이곳에 플레이 버튼을 입력하기 전에 생성할 코드를 입력하세요",
        "WordSparkLv3M2.handle.init(quizData);",
        "this.addChild(WordSparkLv3M2.handle);"
      ],
      "onStart": [
        "// 이곳에 플레이 버튼을 입력하고 난 이후의 코드를 입력하세요.",
        "await WordSparkLv3M2.handle.start();",
        "await SparkApp.mainMenu.mainCharacter.guide(\"nar02\");",
        "await WordSparkLv3M2.handle.play();",
        "await WordSparkLv3M2.handle.finish();",
        "await SparkApp.eop.show( WordSparkLv3M2.handle.completePercent );"
      ],
      "onEnd": [
        "// 이곳에 액티비티 종료시의 코드를 입력하세요"
      ],
      "onUpdate": [
        "// 이곳에 액티비티 Loop Step의 코드를 입력하세요."
      ]
    },
    "gameDataExport": "quizData",
    "extends": {
      "symbol": "ActivityBase",

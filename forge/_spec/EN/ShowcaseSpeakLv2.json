{
  "specVersion": 1,
  "module": "ShowcaseSpeakLv2",
  "subject": "EN",
  "title": "문장 녹음하기 — 화면을 보고 문장을 읽어 녹음합니다",
  "summary": "컴퓨터 화면 안에 그림이 뜨고 위 칠판에 문장이 적혀 있습니다. 스피커를 누르면 문장을 읽어 주고, 읽는 동안 글자에 색이 입혀집니다. 녹음 단추를 눌러 따라 읽으면 게이지가 차고, 멈추면 방금 읽은 것을 다시 들을 수 있습니다. 마음에 들면 다음으로 넘어갑니다. 다 끝나면 녹음한 것들이 한 장씩 넘겨 보는 끝 화면으로 모입니다. 이닝 차례는 열 때마다 섞입니다.",
  "reference": {
    "module": "sparkon_common/_common/module/EN/ShowcaseSpeakLv2",
    "activities": [
      "ENL2M01W4S1",
      "ENL2M03W4S1",
      "ENL2M04W4S1",
      "ENL2M05W4S1",
      "ENL2M06W4S1"
    ]
  },
  "codegen": {
    "hooks": {
      "onLoad": [
        "ShowcaseSpeakLv2.addAsset();"
      ],
      "onInit": [
        "this.addChild(ShowcaseSpeakLv2.handle);",
        "await ShowcaseSpeakLv2.handle.init(quizData);",
        "SparkApp.cms.updateCompleteProgress(0.5);"
      ],
      "onStart": [
        "await ShowcaseSpeakLv2.handle.start();",
        "await ShowcaseSpeakLv2.handle.play();",
        "await ShowcaseSpeakLv2.handle.finish();",
        "SparkApp.eop.show( ShowcaseSpeakLv2.handle.completePercent );"
      ]
    },
    "gameDataExport": "quizData",
    "extends": {
      "symbol": "ActivityBase",
      "from": "@_common/sparkLib/ActivityBase"
    },
    "imports": [
      {
        "symbol": "SparkApp",
        "from": "@_common/sparkLib/Application"
      },
      {
        "symbol": "ShowcaseSpeakLv2",
        "from": "@_common/module/EN/ShowcaseSpeakLv2/ShowcaseSpeakLv2"
      }
    ]
  },
  "assets": {
    "required": [
      {
        "alias": "bg",
        "kind": "image",
        "fixedAlias": true,
        "note": "화면 배경."
      },
      {
        "alias": "computer",
        "kind": "image",
        "fixedAlias": true,
        "note": "가운데 컴퓨터 틀. 자리는 posInfo.computerPos 로 옮깁니다."
      },
      {
        "alias": "computer_ending",
        "kind": "image",
        "fixedAlias": true,
        "note": "끝 화면의 컴퓨터 틀. 앞의 것과 다른 그림입니다."
      },
      {

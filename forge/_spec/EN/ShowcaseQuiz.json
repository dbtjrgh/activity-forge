        "symbol": "SparkApp",
        "from": "@_common/sparkLib/Application"
      },
      {
        "symbol": "delay",
        "from": "@_common/util"
      }
    ]
  },
  "assets": {
    "required": [],
    "providedByModule": {
      "note": "**퀴즈 판은 통째로 모듈 것입니다.** 이닝 표시·체크 표시·스피커 단추·색종이 로티·효과음·문제 꼴마다 다른 안내 나레이션(SL_en_quiz_nar01~24)을 다 들고 있습니다. **액티비티는 문제에 쓰이는 낱말 그림·카드 그림·낱말 소리만 넣습니다.** 배경은 그림이 아니라 색으로 칠합니다 — 그래서 배경 그림이 없습니다.",
      "image": [
        "inning_bg·_cursor·_border·_divide·_gauge",
        "check_on",
        "check_off",
        "sndBtn_* (스피커 단추 색깔별)",

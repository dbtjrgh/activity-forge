      "onLoad": [
        "E09.addAsset();"
      ],
      "onInit": [
        "this.addChild(E09.handle);",
        "await E09.handle.init(quizData);"
      ],
      "onStart": [
        "await E09.handle.start();",
        "await E09.handle.play();",
        "await E09.handle.finish();",
        "//EOP",
        "SparkApp.eop.show(E09.handle.completePercent);"
      ]
    },
    "gameDataExport": "quizData",

  "title": "UFO 로 낱말 빨아올려 문장 만들기",
  "summary": "문장을 듣고 아래 늘어선 낱말 중 맞는 것을 UFO 로 빨아올려 순서대로 문장을 완성하는 활동.",
  "reference": {
    "module": "sparkon_common/_common/module/EN/E39",
    "activities": [
      "ENL2M02W3S3",
      "ENL2M04W3S3",
      "ENL2M06W3S3",
      "ENL2M11W3S3"
    ],
    "doc": "README 없음. 근거는 E39.ts · Asset.ts · component/PlayStage.ts · component/Sentence.ts 와 표본 4차시(1·2·4·6호)입니다. 자리는 네 호 모두 ENL2M__W3S3 입니다."
  },
  "codegen": {
    "hooks": {
      "onLoad": [
        "E39.addAsset();"
      ],
      "onInit": [
        "E39.handle.onInit();",
        "this.addChild(E39.handle);"
      ],
      "onStart": [
        "const bgm = AudioManager.getSound(\"bgm\");",
        "bgm.volume(1);",
        "bgm.loop(true);",
        "bgm.play();",
        "E39.handle.onStart(quizData)"
      ],
      "onEnd": [
        "// 이곳에 액티비티 종료시의 코드를 입력하세요"
      ],
      "onUpdate": [
        "// 이곳에 액티비티 Loop Step의 코드를 입력하세요."
      ]
    },
    "gameDataExport": "quizData",
    "extends": {
      "symbol": "ActivityBase",
      "from": "@_common/sparkLib/ActivityBase"
    },
    "import": {
      "symbol": "E39",
      "from": "@_common/module/EN"
    }
  },

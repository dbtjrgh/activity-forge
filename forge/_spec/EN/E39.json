  "rules": [
    {
      "id": "sentence-words-match",
      "level": "error",
      "check": "sentence 의 모든 낱말이 words[].word 안에 글자까지 같게 있어야 한다.",
      "why": "PlayStage.ts:84 가 문자열로 견줍니다. 한 글자만 달라도 그 낱말은 **아무리 빨아올려도 정답이 되지 않아 이닝이 끝나지 않습니다.**"
    },
    {
      "id": "position-key-exists",
      "level": "error",
      "check": "position 에 그 이닝 words 개수와 같은 열쇠가 있어야 한다.",
      "why": "낱말 개수로 자리표를 찾습니다. 표본은 4·5 만 있으니 6개를 쓰려면 `6` 열쇠를 새로 만들어야 합니다 — 없으면 낱말이 겹쳐 쌓입니다."
    },
    {
      "id": "sentence-delay-length",
      "level": "error",
      "check": "sentenceDelay 의 칸 수가 sentence 낱말 수와 같아야 한다.",
      "why": "Sentence.ts:84 가 칸마다 delay 를 겁니다. 모자라면 뒤쪽 낱말이 한꺼번에 나타납니다."
    },
    {
      "id": "words-more-than-sentence",
      "level": "error",
      "check": "words 개수가 sentence 낱말 수보다 많아야 한다.",
      "why": "오답이 없으면 고를 것이 없어 문제가 성립하지 않습니다."
    },
    {
      "id": "ending-alias-both-kinds",
      "level": "error",
      "check": "`ufo-correct-ending` 을 로티와 음원 양쪽에 같은 이름으로 등록해야 한다.",
      "why": "코드가 같은 문자열로 애니와 소리를 둘 다 찾습니다. 한쪽만 넣으면 그림이나 소리 한쪽이 조용히 빠집니다."
    },
    {
      "id": "delay-is-number",
      "level": "warn",
      "check": "sentenceDelay 값은 ms 수다.",
      "why": "스펙 타입이 string 으로 잡혀 있지만 표본이 계산식을 적어 그렇게 보인 것입니다."
    },
    {
      "id": "fixed-alias-registered",
      "level": "error",
      "check": "위 required 목록의 alias 열여덟 개가 모두 등록돼야 한다.",
      "why": "모듈이 등록하는 것은 폰트·스피커·효과음·도우미 음원뿐입니다."
    }

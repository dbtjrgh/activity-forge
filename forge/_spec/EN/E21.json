  "rules": [
    {
      "id": "fixed-alias-registered",
      "level": "error",
      "check": "bg · bgm · nar · correct_sound · incorrect_sound · flying_sound · inning_end · particle_sound 와 벌 로티 다섯, particle · speaker-ani 가 AssetTable 에 있어야 한다.",
      "why": "꽃과 꽃밭은 모듈이 들고 있지만 벌과 소리는 회차 몫입니다."
    },
    {
      "id": "sentence-words-match",
      "level": "error",
      "check": "sentence 와 words 가 같은 낱말·같은 칸 수여야 하고, sentenceDelay 도 같은 칸 수여야 한다.",
      "why": "sentence 는 맞는 차례를 재고 words 는 꽃에 적힙니다. 한쪽에만 있는 낱말은 눌러도 맞을 수가 없고, sentenceDelay 가 모자라면 그 낱말에서 뜸이 undefined 가 됩니다."
    },
    {
      "id": "word-count-in-flowerpos",
      "level": "error",
      "check": "sentence 칸 수가 flowerPos 에 있는 수(4·5·6)여야 한다.",
      "why": "flowerPos 는 그 세 수에 대한 자리만 들고 있습니다. 셋이나 일곱이면 자리표가 undefined 라 꽃이 (0,0) 에 겹쳐 쌓입니다."
    },
    {
      "id": "sentencedelay-is-string",
      "level": "warn",
      "check": "sentenceDelay 의 값이 글자여야 한다.",
      "why": "기존 3개가 '600' 처럼 따옴표를 붙여 두었습니다. 숫자로 적어도 대개 돌지만 기존과 달라지므로 재현 검사에서 걸립니다."
    },
    {
      "id": "quizinfo-shuffled",
      "level": "warn",
      "check": "quizInfo 의 차례에 뜻이 있으면 안 된다.",
      "why": "E21.ts:96 이 shuffleArray(quizInfo) 를 그대로 부릅니다. **끄는 값이 없습니다.**"
    },
    {
      "id": "alias-exists-in-assettable",
      "level": "error",
      "check": "GameData 가 가리키는 모든 asset alias 가 AssetTable 에 있어야 한다."
    },
    {
      "id": "unknown-field",
      "level": "warn",
      "check": "이 스펙에 없는 키가 GameData 에 있으면 경고."
    }
  ]

{
  "specVersion": 1,
  "module": "ShowcaseWriteLv2",
  "subject": "EN",
  "title": "글자판으로 낱말 쓰기 — 자판을 눌러 낱말을 채웁니다",
  "summary": "아래에 글자 자판이 있고 위에 빈 칸이 놓입니다. 그림과 소리를 보고 글자를 하나씩 눌러 낱말을 채웁니다. 잘못 누르면 지우개로 지울 수 있습니다. 다 채우면 사진이 찍혀 앨범에 쌓이고, 끝나면 앨범에서 낱말을 다시 들을 수 있습니다. 이닝 차례는 열 때마다 섞입니다.",
  "reference": {
    "module": "sparkon_common/_common/module/EN/ShowcaseWriteLv2",
    "activities": [
      "ENL2M01W4S2",
      "ENL2M02W4S2",
      "ENL2M03W4S2",
      "ENL2M04W4S2",
      "ENL2M05W4S2"
    ]
  },
  "codegen": {
    "hooks": {
      "onLoad": [
        "ShowcaseWriteLv2.addAsset();"
      ],
      "onInit": [
        "SparkApp.cms.updateCompleteProgress(0.5);",
        "this.addChild( ShowcaseWriteLv2.handle );",
        "ShowcaseWriteLv2.handle.init(quizData);"
      ],
      "onStart": [
        "await ShowcaseWriteLv2.handle.start();",
        "await ShowcaseWriteLv2.handle.play();",
        "await ShowcaseWriteLv2.handle.finish();",
        "await SparkApp.eop.show(1);"
      ],
      "onEnd": [
        "// 이곳에 액티비티 종료시의 코드를 입력하세요"
      ],
      "onUpdate": [
        "// ShowcaseWriteLv2.handle.onResize();"
      ],
      "onResize": [
        "ShowcaseWriteLv2.handle.onResize();"
      ]
    },
    "gameDataExport": "quizData",
    "extends": {
      "symbol": "ActivityBase",
      "from": "@_common/sparkLib/ActivityBase"
    },
    "imports": [
      {
        "symbol": "ShowcaseWriteLv2",
        "from": "@_common/module/EN"
      },
      {
        "symbol": "SparkApp",
        "from": "@_common/sparkLib/Application"
      }
    ]
  },

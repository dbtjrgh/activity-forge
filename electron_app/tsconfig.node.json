{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    // 앱이 불러 쓰는 forge 코드. composite 프로젝트는 import 하는 파일을 다 적어야 한다.
    "../forge/src/gen/**/*",
    "../forge/src/util/**/*"
  ],
  "exclude": [
    // 액티비티에 복사해 넣을 원본이다. Vue·@_common 을 참조해 여기서 컴파일하면 깨진다
    // (forge 의 tsconfig 도 같은 이유로 뺀다).
    "../forge/src/gen/template/**",
    // 앱이 부르지 않는 것만 뺀다.
    //
    // `draft.ts` 는 2026-09-11 에 **다시 넣었다** — 양산 화면의 「스펙 초안 만들기」가
    // 그 함수를 불렀다. M8 에 옛 양산 창을 걷은 뒤에도 남긴다 — 앱이 부르는 `api.ts` 가
    // import 한다(작업대의 리소스 폴더 만들기). 앱 쪽 noUnusedParameters 에 걸렸던 자리 셋은
    // 지우지 않고 `_` 접두사로 「아직 안 쓰는 자리」임을 밝혀 두었다(주석에 의도가 적힌
    // 자리라 지울 것이 아니었다).
    //
    // `server.ts` 는 forge 의 HTTP 입구다. 앱은 IPC 로 같은 `api.ts` 를 부르므로
    // 필요 없다 — **앱이 HTTP 서버를 띄우는 일은 없다** (`_document/방향.md` 판단 2).
    "../forge/src/gen/server.ts",
    "../forge/src/main.ts",
    "../forge/src/tool/**"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "paths": {
      "@/*": ["../forge/src/*"]
    }
  }
}
